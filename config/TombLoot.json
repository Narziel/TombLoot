// TombLoot — butin d'époque dans les tombeaux.
// Formes écrites "Plugin.esp|0xIDLOCAL" (ID local, sans l'indice d'ordre de chargement).
// Une forme dont le plugin est absent est ignorée (notée dans le log).
{
	// Relevé après le remplacement : ce que chaque coffre de tombeau peut donner (log seulement).
	"survey": true,

	// Plugins dont les armes et armures sont toutes d'époque, quels que soient leurs mots-clés
	// (Ancient Nord Armoury marque ses pièces avec le mot-clé nordique de Dragonborn).
	"ancient_plugins": [ "AncientNordArmo(u)ryEXTREMESE.esp" ],

	"nordic": {
		// Listes des cryptes nordiques dont les entrées génériques sont remplacées.
		"lists": [
			"Skyrim.esm|0x068837",     // LootDraugrWeapon15
			"Skyrim.esm|0x088515",     // LootDraugrWeapon25
			"Skyrim.esm|0x0B4208",     // LootDraugrWeapon100
			"Skyrim.esm|0x1019D0",     // LootDraugr1HWeapon100
			"Dragonborn.esm|0x02C441", // DLC2LootDraugrWeapon15
			"Dragonborn.esm|0x02C444", // DLC2LootDraugrWeapon25
			"Dragonborn.esm|0x02C448", // DLC2LootDraugrWeapon100
			// Sous-listes de mods réservées aux cryptes, qui reprennent elles aussi les listes génériques.
			"Prvti_DragonCultWeapons.esp|0x000CEA", // PI_SublistLootDragonCult1HWeapon
			"Prvti_DragonCultWeapons.esp|0x000CEB"  // PI_SublistLootDragonCult2HWeapon
		],

		// Liste générique -> liste d'époque. Seul l'objet de l'entrée change : niveau et nombre restent.
		"replace": [
			{
				"to": "Skyrim.esm|0x0242FC", // LItemDraugr02Weapon1H
				"from": [
					"Skyrim.esm|0x016578",     // LItemWeaponSword
					"Skyrim.esm|0x016579",     // LItemWeaponWarAxe
					"Skyrim.esm|0x016577",     // LItemWeaponMace
					"Skyrim.esm|0x017178",     // LItemWeaponDagger
					"Skyrim.esm|0x0165BA",     // LItemWeaponAny1H
					"Dragonborn.esm|0x02BC12", // DLC2LItemWeaponSword
					"Dragonborn.esm|0x02BC13", // DLC2LItemWeaponWarAxe
					"Dragonborn.esm|0x02BC11", // DLC2LItemWeaponMace
					"Dragonborn.esm|0x02BC0F"  // DLC2LItemWeaponDagger
				]
			},
			{
				"to": "Skyrim.esm|0x024300", // LItemDraugr02Weapon2H
				"from": [
					"Skyrim.esm|0x01657C",     // LItemWeaponBattleAxe
					"Skyrim.esm|0x01657A",     // LItemWeaponGreatSword
					"Skyrim.esm|0x0165B8",     // LItemWeaponWarhammer
					"Skyrim.esm|0x0165B9",     // LItemWeaponAny2H
					"Dragonborn.esm|0x02BC0D", // DLC2LItemWeaponBattleAxe
					"Dragonborn.esm|0x02BC10", // DLC2LItemWeaponGreatSword
					"Dragonborn.esm|0x02BC14"  // DLC2LItemWeaponWarhammer
				]
			},
			{
				"to": "Skyrim.esm|0x024302", // LItemDraugr02WeaponBow
				"from": [
					"Skyrim.esm|0x017024",     // LItemWeaponBow
					"Dragonborn.esm|0x02BC0E"  // DLC2LItemWeaponBow

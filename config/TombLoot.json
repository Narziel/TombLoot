// TombLoot — butin d'époque dans les tombeaux.
// Formes écrites "Plugin.esp|0xIDLOCAL" (ID local, sans l'indice d'ordre de chargement).
// Une forme dont le plugin est absent est ignorée (notée dans le log).
{
	// Relevé après le remplacement : ce que chaque coffre de tombeau peut donner (log seulement).
	"survey": true,

	// Plugins dont les armes et armures sont toutes d'époque, quels que soient leurs mots-clés
	// (Ancient Nord Armoury marque ses pièces avec le mot-clé nordique de Dragonborn).
	"ancient_plugins": [ "AncientNordArmo(u)ryEXTREMESE.esp" ],

	// Listes créées au lancement, nommées "@nom" dans les remplacements. Une pièce dont le plugin est
	// absent est ignorée ; une liste restée vide prend la liste "fallback". Niveau 1 par défaut ;
	// l'ébène arrive au niveau 38 (paliers de Bethesda), à côté des pièces anciennes.
	"created_lists": {
		"ancient_cuirass": { "items": [
			"Skyrim.esm|0x018388",                           // ArmorDraugrCuirass
			"AncientNordArmo(u)ryEXTREMESE.esp|0x00082E",    // ArmorDraugrCuirassCombo
			"AncientNordArmo(u)ryEXTREMESE.esp|0x00082F",    // ArmorDraugrCuirassMedium
			"AncientNordArmo(u)ryEXTREMESE.esp|0x000830",    // ArmorDraugrCuirassLightFem
			"AncientNordArmo(u)ryEXTREMESE.esp|0x000A6F",
			{ "form": "Skyrim.esm|0x013961", "level": 38 }   // EbonyCuirass
		] },
		"ancient_helmet": { "items": [
			"Skyrim.esm|0x056A9E",                           // ArmorDraugrHelmet

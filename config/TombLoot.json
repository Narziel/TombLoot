// TombLoot — era-appropriate loot in ancient tombs.
// Forms are written "Plugin.esp|0xLOCALID" (local ID, without the load order index).
// A form whose plugin is not loaded is skipped (and noted in the log).
{
	// Report in the log, after the swap: "summary" (a few lines per family: what its chests can
	// give, and where gear of the wrong era comes from), "full" (plus a detailed survey of every
	// tomb list) or "off".
	"survey": "summary",

	// Treasure instead of septims (see "ancient_treasure"): the replacements marked "treasure".
	// false keeps the septims in tombs. Off by itself when a coin mod listed in "treasure_unless" is
	// loaded: C.O.I.N. already gives barrows and Dwemer ruins their own ancient coins.
	"treasure": true,
	"treasure_unless": [ "C.O.I.N.esp" ],

	// Era-appropriate items with no material keyword, for the report only.
	"ancient_items": [ "Dragonborn.esm|0x0398E6" ], // Ancient Nord Pickaxe

	// Plugins whose weapons and armor are all era-appropriate, whatever their keywords (report only;
	// Ancient Nord Armoury tags its pieces with the Dragonborn Nordic keyword).
	"ancient_plugins": [ "AncientNordArmo(u)ryEXTREMESE.esp" ],

	// Lists made at launch, named "@name" in the replacements. A piece whose plugin is missing is
	// skipped; "only_if" keeps it only if one of the plugins is loaded, "unless" drops it if one of
	// them is. A list left empty is replaced by its "fallback" (a form or "@name"); a list with no
	// piece at level 1 gets its fallback at level 1. Level 1 by default.
	// Ebony comes at level 38 (Bethesda's tiers), except with Open World Loot or MorrowLoot
	// Ultimate, which ban random ebony.
	"created_lists": {
		"ancient_cuirass": { "items": [
			"Skyrim.esm|0x018388",                           // ArmorDraugrCuirass
			"AncientNordArmo(u)ryEXTREMESE.esp|0x00082E",    // ArmorDraugrCuirassCombo
			"AncientNordArmo(u)ryEXTREMESE.esp|0x00082F",    // ArmorDraugrCuirassMedium
			"AncientNordArmo(u)ryEXTREMESE.esp|0x000830",    // ArmorDraugrCuirassLightFem
			"AncientNordArmo(u)ryEXTREMESE.esp|0x000A6F",
			{ "form": "Skyrim.esm|0x013961", "level": 38, "unless": [ "Open World Loot.esp", "MLU.esp" ] }   // EbonyCuirass
		] },
		"ancient_helmet": { "items": [
			"Skyrim.esm|0x056A9E",                           // ArmorDraugrHelmet
			"AncientNordArmo(u)ryEXTREMESE.esp|0x000832",    // ArmorDraugrHelmetAntler
			"AncientNordArmo(u)ryEXTREMESE.esp|0x000833",    // ArmorDraugrHelmetInfantry
			"AncientNordArmo(u)ryEXTREMESE.esp|0x000834",    // ArmorDraugrHelmetLord
			"AncientNordArmo(u)ryEXTREMESE.esp|0x000A49",
			{ "form": "Skyrim.esm|0x013963", "level": 38, "unless": [ "Open World Loot.esp", "MLU.esp" ] }   // EbonyHelmet
		] },
		"ancient_gauntlets": { "items": [
			"Skyrim.esm|0x056B17",                           // ArmorDraugrGauntlets
			"AncientNordArmo(u)ryEXTREMESE.esp|0x000831",    // ArmorDraugrGauntletsLight
			{ "form": "Skyrim.esm|0x013962", "level": 38, "unless": [ "Open World Loot.esp", "MLU.esp" ] }   // EbonyGauntlets
		] },
		"ancient_boots": { "items": [
			"Skyrim.esm|0x056A9D",                           // ArmorDraugrBoots
			"AncientNordArmo(u)ryEXTREMESE.esp|0x00082D",    // ArmorDraugrBootsLight
			{ "form": "Skyrim.esm|0x013960", "level": 38, "unless": [ "Open World Loot.esp", "MLU.esp" ] }   // EbonyBoots
		] },
		// Solstheim: the same pieces, plus stalhrim at the ebony tier. Stalhrim, the ice of Solstheim
		// worked by the ancient Nords, belongs only in the island's barrows.
		"solstheim_cuirass": { "extends": "ancient_cuirass", "items": [
			{ "form": "Dragonborn.esm|0x01CD9F", "level": 38 }, // DLC2ArmorStalhrimHeavyCuirass
			{ "form": "Dragonborn.esm|0x01CDA2", "level": 38 }  // DLC2ArmorStalhrimLightCuirass
		] },
		"solstheim_helmet": { "extends": "ancient_helmet", "items": [
			{ "form": "Dragonborn.esm|0x01CDA1", "level": 38 }, // DLC2ArmorStalhrimHeavyHelmet
			{ "form": "Dragonborn.esm|0x01CDA3", "level": 38 }  // DLC2ArmorStalhrimLightHelmet
		] },
		"solstheim_gauntlets": { "extends": "ancient_gauntlets", "items": [
			{ "form": "Dragonborn.esm|0x01CDA0", "level": 38 }, // DLC2ArmorStalhrimHeavyGauntlets
			{ "form": "Dragonborn.esm|0x01CDA5", "level": 38 }  // DLC2ArmorStalhrimLightGauntlets
		] },
		"solstheim_boots": { "extends": "ancient_boots", "items": [
			{ "form": "Dragonborn.esm|0x01CD9E", "level": 38 }, // DLC2ArmorStalhrimHeavyBoots
			{ "form": "Dragonborn.esm|0x01CD7E", "level": 38 }  // DLC2ArmorStalhrimLightBoots
		] },
		"solstheim_shield": { "extends": "ancient_shield", "items": [
			{ "form": "Dragonborn.esm|0x026237", "level": 38 }  // DLC2ArmorStalhrimShield
		] },
		// Enchanted items. Weapons: Bethesda's enchanted Ancient Nord weapons (draugr bosses).
		"ancient_ench_weapon": { "items": [
			"Skyrim.esm|0x0DDD62", // LItemDraugr02BossWeapon1HMagic
			"Skyrim.esm|0x0DDD63"  // LItemDraugr02BossWeapon2HMagic
		] },
		// Armor: Ancient Nord Armoury's enchanted Ancient Nord armor sub-lists, at the tiers the mod
		// gives them (2, 4, 6). Without it, no enchanted Ancient Nord armor exists: an enchanted
		// Ancient Nord weapon is given instead.
		"ancient_ench_armor": {
			"items": [
				{ "form": "AncientNordArmo(u)ryEXTREMESE.esp|0x000961", "level": 2 }, // SublistEnchArmorDraugrCuirass01
				{ "form": "AncientNordArmo(u)ryEXTREMESE.esp|0x000962", "level": 4 },
				{ "form": "AncientNordArmo(u)ryEXTREMESE.esp|0x000963", "level": 6 },
				{ "form": "AncientNordArmo(u)ryEXTREMESE.esp|0x000967", "level": 2 }, // SublistEnchArmorDraugrHelmet01
				{ "form": "AncientNordArmo(u)ryEXTREMESE.esp|0x000968", "level": 4 },
				{ "form": "AncientNordArmo(u)ryEXTREMESE.esp|0x000969", "level": 6 },
				{ "form": "AncientNordArmo(u)ryEXTREMESE.esp|0x000964", "level": 2 }, // SublistEnchArmorDraugrGauntlets01
				{ "form": "AncientNordArmo(u)ryEXTREMESE.esp|0x000965", "level": 4 },
				{ "form": "AncientNordArmo(u)ryEXTREMESE.esp|0x000966", "level": 6 },
				{ "form": "AncientNordArmo(u)ryEXTREMESE.esp|0x00096A", "level": 2 }, // SublistEnchArmorDraugrBoots01
				{ "form": "AncientNordArmo(u)ryEXTREMESE.esp|0x00096B", "level": 4 },
				{ "form": "AncientNordArmo(u)ryEXTREMESE.esp|0x00096C", "level": 6 },
				{ "form": "AncientNordArmo(u)ryEXTREMESE.esp|0x00096E", "level": 2 }, // SublistEnchArmorDraugrShield01
				{ "form": "AncientNordArmo(u)ryEXTREMESE.esp|0x00096F", "level": 4 },
				{ "form": "AncientNordArmo(u)ryEXTREMESE.esp|0x000970", "level": 6 }
			],
			"fallback": "Skyrim.esm|0x0DDD62" // LItemDraugr02BossWeapon1HMagic
		},
		// Instead of the mage robes of the boss chest (LootEnchRobes10): an enchanted piece of the era, with
		// the same chance (1 in 10). An enchanted Ancient Nord weapon, or armor with Ancient Nord Armoury.
		"ancient_robes": { "chance_none": 90, "extends": "ancient_ench_armor", "items": [
			"Skyrim.esm|0x0DDD62", // LItemDraugr02BossWeapon1HMagic
			"Skyrim.esm|0x0DDD63"  // LItemDraugr02BossWeapon2HMagic
		] },
		// Solstheim: the same, plus Dragonborn's enchanted stalhrim at the ebony tier.
		"solstheim_ench_weapon": { "extends": "ancient_ench_weapon", "items": [
			{ "form": "Dragonborn.esm|0x037846", "level": 38 } // DLC2LItemEnchStalhrimWeaponAny75
		] },
		"solstheim_ench_armor": { "extends": "ancient_ench_armor", "items": [
			{ "form": "Dragonborn.esm|0x037847", "level": 38 } // DLC2LItemEnchStalhrimArmorAny75
		] },
		// Special loot of draugr boss chests: the best of the era. Higher-tier draugr boss weapons,
		// Ancient Nord armor at the best enchantment, and the miscellaneous share of Bethesda's
		// special loot.
		"ancient_special": {
			"items": [
				"Skyrim.esm|0x0DDD70",                         // LItemDraugr04BossWeapon1HMagic
				"Skyrim.esm|0x0DDD71",                         // LItemDraugr04BossWeapon2HMagic
				"AncientNordArmo(u)ryEXTREMESE.esp|0x000963",  // SublistEnchArmorDraugrCuirass03
				"AncientNordArmo(u)ryEXTREMESE.esp|0x000969",  // SublistEnchArmorDraugrHelmet03
				"AncientNordArmo(u)ryEXTREMESE.esp|0x000966",  // SublistEnchArmorDraugrGauntlets03
				"AncientNordArmo(u)ryEXTREMESE.esp|0x00096C",  // SublistEnchArmorDraugrBoots03
				"AncientNordArmo(u)ryEXTREMESE.esp|0x000970",  // SublistEnchArmorDraugrShield03
				"Skyrim.esm|0x10FCEF"                          // miscellaneous special loot
			],
			"fallback": "Skyrim.esm|0x0DDD70"
		},
		"solstheim_special": { "extends": "ancient_special", "items": [
			{ "form": "Dragonborn.esm|0x037846", "level": 38 }, // DLC2LItemEnchStalhrimWeaponAny75
			{ "form": "Dragonborn.esm|0x037847", "level": 38 }  // DLC2LItemEnchStalhrimArmorAny75
		] },
		// Dwemer ruins. Enchanted weapons: Bethesda's enchanted Dwarven weapons.
		"dwemer_ench_weapon": { "items": [
			"Skyrim.esm|0x0C9A36", // LItemEnchDwarvenSword
			"Skyrim.esm|0x0C9A37", // LItemEnchDwarvenWarAxe
			"Skyrim.esm|0x0C9A35", // LItemEnchDwarvenMace
			"Skyrim.esm|0x0C9A33", // LItemEnchDwarvenDagger
			"Skyrim.esm|0x0C9A34", // LItemEnchDwarvenGreatSword
			"Skyrim.esm|0x0C9A31", // LItemEnchDwarvenBattleaxe
			"Skyrim.esm|0x0C9A38", // LItemEnchDwarvenWarhammer
			"Skyrim.esm|0x0C9A32"  // LItemEnchDwarvenBow
		] },
		// Enchanted armor: Bethesda's enchanted Dwarven armor sub-lists, three tiers.
		"dwemer_ench_armor": { "items": [
			"Skyrim.esm|0x08B64A", { "form": "Skyrim.esm|0x08B64B", "level": 15 }, { "form": "Skyrim.esm|0x08B64C", "level": 17 }, // cuirass
			"Skyrim.esm|0x08B650", { "form": "Skyrim.esm|0x08B651", "level": 15 }, { "form": "Skyrim.esm|0x08B652", "level": 17 }, // helmet
			"Skyrim.esm|0x08B64D", { "form": "Skyrim.esm|0x08B64E", "level": 15 }, { "form": "Skyrim.esm|0x08B64F", "level": 17 }, // gauntlets
			"Skyrim.esm|0x08B647", { "form": "Skyrim.esm|0x08B648", "level": 15 }, { "form": "Skyrim.esm|0x08B649", "level": 17 }, // boots
			"Skyrim.esm|0x08B653", { "form": "Skyrim.esm|0x08FFEF", "level": 15 }, { "form": "Skyrim.esm|0x08FFF0", "level": 17 }  // shield
		] },
		// Special loot of Dwemer chests: enchanted Dwarven boss weapons, Dwarven armor at the best
		// enchantment, and the miscellaneous share of Bethesda's special loot.
		"dwemer_special": { "items": [
			"Skyrim.esm|0x0DDD8C", // LItemEnchDwarvenSwordBoss
			"Skyrim.esm|0x0DDD9C", // LItemEnchDwarvenWarAxeBoss
			"Skyrim.esm|0x0DDD94", // LItemEnchDwarvenMaceBoss
			"Skyrim.esm|0x0DDD7C", // LItemEnchDwarvenGreatSwordBoss
			"Skyrim.esm|0x0DDD73", // LItemEnchDwarvenBattleaxeBoss
			"Skyrim.esm|0x0DDD84", // LItemEnchDwarvenWarhammerBoss
			"Skyrim.esm|0x08B64C", // SublistEnchArmorDwarvenCuirass04
			"Skyrim.esm|0x08B652", // SublistEnchArmorDwarvenHelmet04
			"Skyrim.esm|0x08B64F", // SublistEnchArmorDwarvenGauntlets04
			"Skyrim.esm|0x08B649", // SublistEnchArmorDwarvenBoots04
			"Skyrim.esm|0x08FFF0", // SublistEnchArmorDwarvenShield04
			"Skyrim.esm|0x10FCEF"  // miscellaneous special loot
		] },
		// The 10 % special loot keeps its chance: 90 % of giving nothing.
		"dwemer_special10": { "extends": "dwemer_special", "chance_none": 90, "items": [] },
		"ancient_special10": { "extends": "ancient_special", "chance_none": 90, "items": [] },
		"solstheim_special10": { "extends": "solstheim_special", "chance_none": 90, "items": [] },
		"ancient_shield": {
			"items": [
				"AncientNordArmo(u)ryEXTREMESE.esp|0x000835", // ArmorDraugrShield
				// Not the draugr shield list (LItemDraugrShield): an iron shield in vanilla and MorrowLoot,
				// Dragonborn's battered iron shield with Open World Loot.
				{ "form": "MLU.esp|0x05CACA", "level": 21 },  // ANHShield, Ancient Nord Hero shield (MorrowLoot Ultimate)
				{ "form": "Skyrim.esm|0x013964", "level": 38, "unless": [ "Open World Loot.esp", "MLU.esp" ] } // EbonyShield
			],
			// No ancient shield without these mods: an Ancient Nord helmet instead of an iron shield.
			"fallback": "@ancient_helmet"
		},

		// Treasure instead of septims. The Septim coin dates from the Second Era; the dead of the
		// barrows and the Dwemer were gone long before. Their gold becomes bullion, ore and gems of the
		// same average value, at the same levels: worth as much, but it must be sold (or worked).
		// To keep septims in tombs, set "treasure" to false at the top of this file.
		// Values: silver ingot 50, gold ore 50, gold ingot 100, garnet 100, flawless garnet 150,
		// amethyst 120, ruby 200, Dwarven metal ingot 30, Dwarven scrap metal 15, silver ore 25, cog 5.
		// Boss chest gold (50, 100, 150, 200, 250 coins at levels 1, 6, 11, 16, 21; one amount, the
		// highest reached): two treasures of that value at each level.
		"ancient_treasure": { "pick": "highest", "items": [
			{ "form": "Skyrim.esm|0x05ACE3", "level": 1 },              // silver ingot (50)
			{ "form": "Skyrim.esm|0x05ACDE", "level": 1 },              // gold ore (50)
			{ "form": "Skyrim.esm|0x05AD9E", "level": 6 },              // gold ingot (100)
			{ "form": "Skyrim.esm|0x063B45", "level": 6 },              // garnet (100)
			{ "form": "Skyrim.esm|0x05ACE3", "level": 11, "count": 3 }, // silver ingots (150)
			{ "form": "Skyrim.esm|0x068521", "level": 11 },             // flawless garnet (150)
			{ "form": "Skyrim.esm|0x063B42", "level": 16 },             // ruby (200)
			{ "form": "Skyrim.esm|0x05AD9E", "level": 16, "count": 2 }, // gold ingots (200)
			{ "form": "Skyrim.esm|0x05ACE3", "level": 21, "count": 5 }, // silver ingots (250)
			{ "form": "Skyrim.esm|0x063B46", "level": 21, "count": 2 }  // amethysts (240)
		] },
		// Solstheim: the same, and a piece of stalhrim at the highest level.
		"solstheim_treasure": { "extends": "ancient_treasure", "pick": "highest", "items": [
			{ "form": "Dragonborn.esm|0x02B06B", "level": 21 }          // stalhrim (200)
		] },
		// The 20 coins of an ordinary barrow chest, coin by coin: 1 in 25 is a nugget of silver ore
		// (worth 25), so 20 coins give about 20 in value.
		"ancient_coin": { "chance_none": 96, "items": [ "Skyrim.esm|0x05ACDF" ] },  // silver ore
		// Loose change (1 to 9 coins) in barrow chests and alcove corpses, and on the draugr.
		"ancient_change": { "chance_none": 85, "items": [ "Skyrim.esm|0x05ACDF" ] },
		"ancient_change25": { "chance_none": 96, "items": [ "Skyrim.esm|0x05ACDF" ] },
		// The loose change of a ruin urn (1 to 9 coins, 5 on average): 1 in 5 is a nugget of silver ore.
		"ancient_urn_change": { "chance_none": 80, "items": [ "Skyrim.esm|0x05ACDF" ] },
		// Dwemer boss chest gold (50 to 250 coins at levels 1 to 21, one among all those reached).
		"dwemer_treasure": { "items": [
			{ "form": "Skyrim.esm|0x0DB8A2", "level": 1, "count": 2 },  // Dwarven metal ingots (60)
			{ "form": "Skyrim.esm|0x0C886A", "level": 1, "count": 3 },  // Dwarven scrap metal (45)
			{ "form": "Skyrim.esm|0x0DB8A2", "level": 6, "count": 3 },  // (90)
			{ "form": "Skyrim.esm|0x063B45", "level": 6 },              // garnet (100)
			{ "form": "Skyrim.esm|0x0DB8A2", "level": 11, "count": 5 }, // (150)
			{ "form": "Skyrim.esm|0x068521", "level": 11 },             // flawless garnet (150)
			{ "form": "Skyrim.esm|0x0DB8A2", "level": 16, "count": 7 }, // (210)
			{ "form": "Skyrim.esm|0x063B42", "level": 16 },             // ruby (200)
			{ "form": "Skyrim.esm|0x0DB8A2", "level": 21, "count": 8 }, // (240)
			{ "form": "Skyrim.esm|0x063B46", "level": 21, "count": 2 }  // amethysts (240)
		] },
		"dwemer_change": { "chance_none": 30, "items": [ "Skyrim.esm|0x0AEBF1" ] }  // Dwemer cog
	},

	"nordic": {
		// Lists of the Nordic barrows whose generic entries are replaced.
		"lists": [
			"Skyrim.esm|0x068837",     // LootDraugrWeapon15
			"Skyrim.esm|0x088515",     // LootDraugrWeapon25
			"Skyrim.esm|0x0B4208",     // LootDraugrWeapon100
			"Skyrim.esm|0x1019D0",     // LootDraugr1HWeapon100
			// Mod sub-lists used only by tombs (Prvti_DragonCultWeapons…) are found by themselves
			// ("auto_sublists": true by default), like the chests that hold these lists ("auto_chests").
			"Skyrim.esm|0x0C2963",     // LootDraugrArmor10
			"Skyrim.esm|0x06883B",     // LootDraugrArmor25
			"Skyrim.esm|0x088514",     // LootDraugrArmor50
			"Skyrim.esm|0x0B4202",     // LootDraugrArmor100
			"Skyrim.esm|0x0B555E",     // LootDraugrEnchWeapons15
			"Skyrim.esm|0x0B5563",     // LootDraugrEnchWeapons25
			"Skyrim.esm|0x01ED1B",     // LootDraugrEnchWeapons100
			"Skyrim.esm|0x0B5561",     // LootDraugrEnchArmor15
			"Skyrim.esm|0x0B5562",     // LootDraugrEnchArmor25
			"Skyrim.esm|0x034902",     // LootDraugrEnchArmor100
			"Skyrim.esm|0x08850E",     // LootDraugrArrows15 (barrow chests: generic arrows until 1.2)
			"Skyrim.esm|0x0B4203",     // LootDraugrArrows100
			"Skyrim.esm|0x04F78C",     // DeathItemDraugrGold (coins on the draugr)
			"Skyrim.esm|0x03AD7E",     // DeathItemDragonPriest (gold of the dragon priests)
			"Skyrim.esm|0x10FCFC",     // LootUrnSmallTreasure30 (ruin urns; its gold list is shared with burnt corpses, so it is swapped here only)
			"RoleRim - Loot.esp|0x000211"  // rr_Loot_Gold_Draugr (Roleplaying in Skyrim - Loot Overhaul: barrow chest gold)
		],

		// Chests whose own entries are replaced: their special loot is a list shared with 35 chests
		// (Dwemer and Falmer bosses…), which stays intact. Every chest holding one of "lists" is added.
		"containers": [
			"Skyrim.esm|0x020671",     // TreasDraugrChestBoss
			"Skyrim.esm|0x020670",     // TreasDraugrChest (10 % special loot in the base game)
			// Corpses in the barrow alcoves (their loose change).
			"Skyrim.esm|0x023969", "Skyrim.esm|0x08008F", "Skyrim.esm|0x080090", "Skyrim.esm|0x080091", "Skyrim.esm|0x080092",
			"Skyrim.esm|0x080093", "Skyrim.esm|0x080094", "Skyrim.esm|0x08008D", "Skyrim.esm|0x08008E", "Skyrim.esm|0x0DB047"
		],

		// Weapons with one of these material keywords that a mod put in the generic lists (Reforging
		// does, for its Ancient Nord weapons) are added to the era list that replaces them, so they
		// stay in tombs. [] turns it off.
		"era_keywords": [ "WeapMaterialDraugr", "WeapMaterialDraugrHoned" ],
		// Weapons and armor placed by hand in the base game (altars, tables, floors) in these places get a
		// piece of the same kind from the era lists below when they load: the same each time, nothing in the
		// save. Quest, owned and enchanted-by-hand pieces stay. Remove "placed" to turn it off.
		"placed": { "loc_types": [ "LocTypeDraugrCrypt", "LocTypeDragonPriestLair" ] },

		// Generic list -> era list. Only the entry's object changes: level and count stay.
		"replace": [
			// Gold: treasure of the same value instead of septims (see "ancient_treasure").
			{
				"to": "@ancient_treasure",
				"from": [
					"Skyrim.esm|0x088513",     // LootDraugrGoldBoss01
					"Skyrim.esm|0x088512"      // LootDraugrGold
				],
				"treasure": true
			},
			{ "to": "@ancient_coin", "from": [ "Skyrim.esm|0x00000F" ], "treasure": true },      // Gold001, coins put straight in a chest
